# Yogeshwari Dairy Shop - Environment Configuration
# Copy this file to .env and insert your Supabase and Render backend settings

PORT=5000
VITE_BACKEND_URL=https://yogeshwari-dairy-shop-inventory-system.onrender.com
VITE_API_BASE_URL=https://yogeshwari-dairy-shop-inventory-system.onrender.com/api/v1

# Supabase PostgreSQL and Authentication Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Feature Flags (default false in production; set to true to enable)
VITE_ENABLE_GUEST_MODE=false
VITE_ENABLE_REGISTRATION=false


  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build:all": "npm run build && npm run client:build && npm run server:build",
